# Backend only. Never use a VITE_ prefix for secrets.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
TYPESAFE_TIMEOUT_S=20
DEALCOMPASS_ENGINE_MODE=rules
DEALCOMPASS_ANALYSIS_BUDGET_S=15
# All team processes MUST share one absolute SQLite path on one backend host.
# Default: ~/.local/share/dealcompass/typesafe-usage.sqlite3
TYPESAFE_USAGE_DB=
# Explicit loader: python -m backend.integrations.jev_live --env-file .env check
# Frontend default proxy: /api -> http://127.0.0.1:8000

# Railway production server: set these in Railway Variables (not VITE_*).
# backend.deployment reads process environment; it does not auto-load .env.
# Set 1 for the public demo (no login); 0 retains optional Basic Auth.
DEALCOMPASS_PUBLIC_ACCESS=1
# Production: /data/uploads on the existing persistent volume.
DEALCOMPASS_UPLOAD_DIR=.local/uploads
DEALCOMPASS_DEMO_USER=team
DEALCOMPASS_DEMO_PASSWORD=
# Mount one Railway volume at /data before enabling live Jev.
# TYPESAFE_USAGE_DB=/data/typesafe-usage.sqlite3
# DEALCOMPASS_ANALYSIS_CACHE_DB=/data/analysis-cache.sqlite3
# PORT is supplied by Railway. Keep one service replica / one Python worker.
