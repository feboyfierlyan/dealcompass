# Backend only. Never use a VITE_ prefix for secrets.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
TYPESAFE_TIMEOUT_S=20
DEALCOMPASS_ENGINE_MODE=rules
DEALCOMPASS_ANALYSIS_BUDGET_S=15
# All team processes MUST share one absolute SQLite path on one backend host.
# Default: ~/.local/share/dealcompass/typesafe-usage.sqlite3
TYPESAFE_USAGE_DB=
# Explicit loader: python -m backend.integrations.jev_live --env-file .env check
# Frontend default proxy: /api -> http://127.0.0.1:8000
